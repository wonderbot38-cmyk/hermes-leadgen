# Copy to .env and fill with your service credentials
# Or start the app and paste keys in the dashboard APIs tab

# Apify — lead discovery (required for pipeline scrape)
APIFY_TOKEN=

# Snov.io — email find + verify
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# Linkup — personalization
LINKUP_API_KEY=

# Gmail — outbound sending (App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Airtable — CRM
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Google Drive — media link used in outreach emails
DRIVE_LINK=
